<?xml version="1.0" encoding="UTF-8"?>
<manifest>

  <remote  name="weeb-dev"
           fetch="https://github.com/WeebFork"
           revision="lineage-23.0" />

  <remote  name="clo"
           fetch="https://git.codelinaro.org/clo/la"
           revision="base-linaro-os.6.0.r1" />

  <project path="art" name="platform_art" remote="weeb-dev" />
  <project path="bionic" name="platform_bionic" remote="weeb-dev" />
  <project path="build/make" name="platform_build" remote="weeb-dev">
    <copyfile src="core/root.mk" dest="Makefile" />
    <linkfile src="CleanSpec.mk" dest="build/CleanSpec.mk" />
    <linkfile src="buildspec.mk.default" dest="build/buildspec.mk.default" />
    <linkfile src="core" dest="build/core" />
    <linkfile src="envsetup.sh" dest="build/envsetup.sh" />
    <linkfile src="target" dest="build/target" />
    <linkfile src="tools" dest="build/tools" />
  </project>
  <project path="build/soong" name="platform_build_soong" remote="weeb-dev">
    <linkfile src="root.bp" dest="Android.bp" />
    <linkfile src="bootstrap.bash" dest="bootstrap.bash" />
  </project>

  <project path="frameworks/base" name="platform_frameworks_base" remote="weeb-dev" />
  <project path="frameworks/av" name="platform_frameworks_av" remote="weeb-dev" />
  <project path="frameworks/native" name="platform_frameworks_native" remote="weeb-dev" />

  <project path="hardware/qcom-caf/common" name="LineageOS/android_hardware_qcom_common" remote="github" />
  <project path="hardware/qcom-caf/wlan" name="LineageOS/android_hardware_qcom_wlan" remote="github" />
  
  <project path="hardware/qcom-caf/sm8150/audio" name="LineageOS/android_hardware_qcom_audio" remote="github" groups="qcom_sm8150" />
  <project path="hardware/qcom-caf/sm8150/display" name="LineageOS/android_hardware_qcom_display" remote="github" groups="qcom_sm8150" />
  <project path="hardware/qcom-caf/sm8150/media" name="LineageOS/android_hardware_qcom_media" remote="github" groups="qcom_sm8150" />

  <project path="vendor/weeb" name="platform_vendor_weeb" remote="weeb-dev" />
  <project path="packages/apps/WeebCustomizer" name="platform_packages_apps_WeebCustomizer" remote="weeb-dev" />
  <project path="packages/apps/Launcher3" name="platform_packages_apps_Launcher3" remote="weeb-dev" />
  <project path="packages/apps/Settings" name="platform_packages_apps_Settings" remote="weeb-dev" />

  <project path="system/core" name="platform_system_core" remote="weeb-dev" />
